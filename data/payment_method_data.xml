<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_method_sep" model="payment.method">
        <field name="name">SEP (Saman Electronic Payment)</field>
        <field name="code">sep</field>
        <field name="sequence">14</field>
        <field name="active">False</field>
        <field name="image" type="base64" file="oe_payment_sep/static/description/icon.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <!-- Refund support is disabled by default if not specified -->
        <field name="supported_country_ids"
               eval="[Command.set([
                         ref('base.ir'),
                     ])]"
        />
        <field name="supported_currency_ids"
               eval="[Command.set([
                         ref('base.IRR'),
                     ])]"
        />
    </record>
</odoo>