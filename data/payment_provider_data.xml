<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_sep" model="payment.provider">
        <field name="name">SEP (Saman Electronic Payment)</field>
        <field name="code">sep</field>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="image_128" type="base64" file="oe_payment_sep/static/description/icon.png"/>
        <!-- Ensure 'oe_payment_sep' matches your module technical name -->
        <field name="module_id" ref="base.module_oe_payment_sep"/>
        <field name="payment_method_ids"
               eval="[Command.set([
                         ref('oe_payment_sep.payment_method_sep'),
                     ])]"
        />
    </record>
</odoo>